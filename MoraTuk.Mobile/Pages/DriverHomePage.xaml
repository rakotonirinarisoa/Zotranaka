<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MoraTuk.Mobile.Pages.DriverHomePage"
    BackgroundColor="#F5F7F8">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <Frame
                HeightRequest="100"
                WidthRequest="100"
                CornerRadius="50"
                BackgroundColor="#00A86B"
                HorizontalOptions="Center"
                HasShadow="True">

                <Label
                    Text="🚕"
                    FontSize="50"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Frame>


            <!-- ================================================= -->
            <!-- TITRE -->
            <!-- ================================================= -->

            <Label
                Text="Mode Chauffeur"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#222"/>


            <!-- ================================================= -->
            <!-- STATUT -->
            <!-- ================================================= -->

            <Frame
                BackgroundColor="#E8FFF1"
                BorderColor="#00A86B"
                CornerRadius="15"
                Padding="15">

                <HorizontalStackLayout
                    Spacing="10">

                    <Label
                        Text="🟢"
                        FontSize="22"/>

                    <Label
                        x:Name="StatusLabel"
                        Text="Statut : Hors ligne"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </Frame>


            <!-- ================================================= -->
            <!-- INFORMATION -->
            <!-- ================================================= -->

            <Frame
                BackgroundColor="White"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="📋 Courses disponibles"
                        FontAttributes="Bold"
                        FontSize="18"/>

                    <Label
                        x:Name="RideLabel"
                        Text="Recherche des courses..."
                        FontSize="16"
                        TextColor="#00A86B"/>

                </VerticalStackLayout>

            </Frame>


            <!-- ================================================= -->
            <!-- LISTE DES COURSES -->
            <!-- ================================================= -->

            <VerticalStackLayout
                x:Name="RidesContainer"
                Spacing="15"/>


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>