<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MoraTuk.Mobile.Pages.DriverHomePage"
    Title="Mode Chauffeur"
    BackgroundColor="#F5F7FB">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <!-- Logo -->
            <Frame
                HeightRequest="100"
                WidthRequest="100"
                CornerRadius="50"
                BackgroundColor="#00A86B"
                HorizontalOptions="Center"
                HasShadow="True">

                <Label
                    Text="🚕"
                    FontSize="50"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Frame>

            <!-- Titre -->
            <Label
                Text="Mode Chauffeur"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#222"/>

            <!-- Statut -->
            <Frame
                BackgroundColor="#E8FFF1"
                BorderColor="#00A86B"
                CornerRadius="15"
                Padding="15">

                <HorizontalStackLayout Spacing="10">

                    <Label
                        Text="🟢"
                        FontSize="22"/>

                    <Label
                        x:Name="StatusLabel"
                        Text="Statut : Hors ligne"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </Frame>

            <!-- Aucune course -->
            <Frame
                BackgroundColor="White"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout>

                    <Label
                        Text="📋 Dernière information"
                        FontAttributes="Bold"
                        FontSize="18"/>

                    <Label
                        x:Name="RideLabel"
                        Text="Aucune nouvelle course"
                        FontSize="16"
                        TextColor="#00A86B"/>

                </VerticalStackLayout>

            </Frame>

            <!-- Nouvelle course -->
            <Frame
                x:Name="RideFrame"
                IsVisible="False"
                BackgroundColor="White"
                CornerRadius="20"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout
                    Spacing="15">

                    <Label
                        x:Name="RideTitleLabel"
                        Text="🚕 Nouvelle course"
                        FontAttributes="Bold"
                        FontSize="22"/>

                    <Label
                        x:Name="RideStatusLabel"
                        Text="En attente d'acceptation"
                        TextColor="Green"/>
                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#DDDDDD"/>

                    <Label
                        x:Name="RideInfoLabel"
                        FontSize="18"
                        TextColor="#333"/>

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="15">

                        <Button
                            x:Name="AcceptButton"
                            Text="✅ Accepter"
                            Clicked="AcceptRide_Clicked"
                            BackgroundColor="Green"
                            TextColor="White"/>

                        <Button
                            x:Name="RejectButton"
                            Text="❌ Refuser"
                            Clicked="RejectRide_Clicked"
                            BackgroundColor="Red"
                            TextColor="White"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>